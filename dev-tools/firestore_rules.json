{
  "rules_version": "2",
  "service": "cloud.firestore",
  "match": {
    "databases": {
      "(database)": {
        "documents": {
          "users/{userId}": {
            "devices/{deviceId}": {
              "allow": ["read", "write"],
              "if": "request.auth != null && request.auth.uid == userId"
            },
            "devices/{deviceId}/readings/{readingId}": {
              "allow": ["create"],
              "if": "request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true)",
              "allow": ["read"],
              "if": "request.auth != null && request.auth.uid == userId",
              "allow": ["delete", "update"],
              "if": false
            }
          }
        }
      }
    }
  }
}
